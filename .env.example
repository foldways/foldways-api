# The service settings below are read when `modal deploy` builds the app, so they are
# baked into the deployment. Change one and redeploy for it to take effect.

# Boltz-2
BOLTZ2_GPU=H100
BOLTZ2_TIMEOUT=1800
BOLTZ2_MAX_CONTAINERS=5
BOLTZ2_SCALEDOWN_WINDOW=60

# ESMC
ESMC_GPU=L4
ESMC_TIMEOUT=600
ESMC_MAX_CONTAINERS=5
ESMC_SCALEDOWN_WINDOW=60

# ESMFold2
ESMFOLD2_GPU=H100
ESMFOLD2_TIMEOUT=1800
ESMFOLD2_MAX_CONTAINERS=5
ESMFOLD2_SCALEDOWN_WINDOW=60

# BoltzGen
BOLTZGEN_GPU=H100
BOLTZGEN_TIMEOUT=1800
BOLTZGEN_MAX_CONTAINERS=5
BOLTZGEN_SCALEDOWN_WINDOW=60

# ProteinMPNN
PROTEINMPNN_GPU=L4
PROTEINMPNN_TIMEOUT=600
PROTEINMPNN_MAX_CONTAINERS=5
PROTEINMPNN_SCALEDOWN_WINDOW=60

# Development only. Used by local scripts for manual testing.
# URL format: https://your-workspace--foldways-api.modal.run
FOLDWAYS_API_URL=
